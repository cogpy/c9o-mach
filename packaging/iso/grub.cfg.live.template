set timeout=10
set default=0

# Colors and appearance
set menu_color_normal=white/black
set menu_color_highlight=black/light-gray

# Terminal settings
terminal_output console
terminal_input console

menuentry "c9o-mach Live (RAM-based system)" {
    echo "Loading GNU Mach microkernel..."
    multiboot /boot/gnumach console=com0 live root=ramdisk
    echo "Loading root filesystem..."
    module /boot/modules/rootfs.img rootfs
    boot
}

menuentry "c9o-mach Live (with verbose logging)" {
    echo "Loading GNU Mach microkernel with verbose logging..."
    multiboot /boot/gnumach console=com0 live root=ramdisk verbose console_timestamps=on
    module /boot/modules/rootfs.img rootfs
    boot
}

menuentry "c9o-mach Debug Mode (KDB enabled)" {
    echo "Loading GNU Mach with kernel debugger..."
    multiboot /boot/gnumach console=com0 live root=ramdisk debug kdb console_timestamps=on timestamp_format=precise
    module /boot/modules/rootfs.img rootfs
    boot
}

menuentry "c9o-mach Rescue Mode (minimal environment)" {
    echo "Loading GNU Mach rescue environment..."
    multiboot /boot/gnumach console=com0 rescue root=ramdisk single
    module /boot/modules/rootfs.img rootfs
    boot
}

menuentry "Hardware Detection Mode" {
    echo "Loading GNU Mach with hardware detection..."
    multiboot /boot/gnumach console=com0 live root=ramdisk hwdetect verbose
    module /boot/modules/rootfs.img rootfs
    boot
}

menuentry "Memory Test (memtest86+)" {
    echo "Loading memory test..."
    linux16 /boot/memtest86+.bin
}

menuentry "Reboot" {
    reboot
}

menuentry "Shutdown" {
    halt
}
