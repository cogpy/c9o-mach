#
# The `module' lines are boot script commands rather than plain file
# names: GNU Mach hands everything following the file name to the task
# it creates from the module, see kern/bootstrap.c.  A line whose first
# word starts with `#' is a comment for the boot script parser, which is
# how data modules such as the root file system image are loaded without
# being executed.

set timeout=5
set default=0

# Colors and appearance
set menu_color_normal=white/black
set menu_color_highlight=black/light-gray

# Terminal settings, com0 is also the console used by the kernel
serial --unit=0 --speed=115200
terminal_output console serial
terminal_input console serial

menuentry "Install c9o-mach" {
    echo "Starting c9o-mach installation..."
    multiboot /boot/gnumach console=com0 install
    echo "Loading installer..."
    module /boot/modules/installer installer '${host-port}' '${device-port}' '${kernel-command-line}' '$(task-create)' '$(task-resume)'
    echo "Loading root file system..."
    module /boot/modules/rootfs.img '#rootfs'
    boot
}

menuentry "Install c9o-mach (Expert Mode)" {
    echo "Starting c9o-mach installation in expert mode..."
    multiboot /boot/gnumach console=com0 install expert verbose
    module /boot/modules/installer installer '${host-port}' '${device-port}' '${kernel-command-line}' '$(task-create)' '$(task-resume)'
    module /boot/modules/rootfs.img '#rootfs'
    boot
}

menuentry "Install c9o-mach (with Debug Output)" {
    echo "Starting c9o-mach installation with debug output..."
    multiboot /boot/gnumach console=com0 install debug console_timestamps=on
    module /boot/modules/installer installer '${host-port}' '${device-port}' '${kernel-command-line}' '$(task-create)' '$(task-resume)'
    module /boot/modules/rootfs.img '#rootfs'
    boot
}

menuentry "c9o-mach Live Environment" {
    echo "Loading c9o-mach live environment..."
    multiboot /boot/gnumach console=com0 live
    module /boot/init init '${host-port}' '${device-port}' '${kernel-command-line}' '$(task-create)' '$(task-resume)'
    module /boot/modules/rootfs.img '#rootfs'
    boot
}

menuentry "c9o-mach Rescue Mode" {
    echo "Loading c9o-mach rescue environment..."
    multiboot /boot/gnumach console=com0 rescue single
    module /boot/init init '${host-port}' '${device-port}' '${kernel-command-line}' '$(task-create)' '$(task-resume)'
    module /boot/modules/rootfs.img '#rootfs'
    boot
}

menuentry "Boot from Hard Disk" {
    echo "Booting from first hard disk..."
    set root=(hd0)
    chainloader +1
}

menuentry "Reboot" {
    reboot
}

menuentry "Shutdown" {
    halt
}
